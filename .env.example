# Copie para .env se quiser sobrescrever algo. Tudo aqui é OPCIONAL - o
# servidor sobe e funciona sem nenhum .env, e a conta do pai é criada no
# primeiro acesso pelo navegador. O .env nunca vai pro git.

# Chave de assinatura dos tokens JWT. Se ficar em branco, é gerada sozinha na
# primeira subida e guardada no banco - que é o caminho normal, inclusive na
# instalação pela loja do CasaOS. Só defina aqui se quiser controlar a chave.
# Trocá-la invalida todas as sessões (todo mundo precisa logar de novo).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# Validade do token de acesso. 30 dias porque é um app familiar em rede local -
# ninguém quer digitar senha toda semana, e o gate de rede já barra o uso fora
# de casa (ver CLAUDE.md).
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Porta exposta no host (ZimaOS). 8090 foi escolhida por estar livre.
PORT=8090
