# Copie para .env e preencha. O .env nunca vai pro git.

# Conta de admin criada no primeiro start do backend. Depois disso o arquivo
# não manda mais na senha - trocar senha é dentro do app, na tela de usuários.
ADMIN_USERNAME=pai
ADMIN_PASSWORD=troque-esta-senha
ADMIN_DISPLAY_NAME=Pai

# Chave de assinatura dos tokens JWT. Gere uma nova com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar essa chave invalida todas as sessões (todo mundo precisa logar de novo).
SECRET_KEY=troque-esta-chave

# Validade do token de acesso. 30 dias porque é um app familiar em rede local -
# ninguém quer digitar senha toda semana, e o gate de rede já barra o uso fora
# de casa (ver CLAUDE.md).
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Porta exposta no host (ZimaOS). 8090 foi escolhida por estar livre.
PORT=8090
